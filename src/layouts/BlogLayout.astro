---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  description?: string;
  publishDate?: string;
  coverImage?: string;
}

const { title, description, publishDate, coverImage } = Astro.props;
---

<Layout
  title={title}
  description={description}
  image={coverImage}
  type={publishDate ? 'article' : 'website'}
  publishDate={publishDate}
>
  <slot />
</Layout>
