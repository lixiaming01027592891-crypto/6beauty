---
import type { Service } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import { services, siteConfig } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const serviceUrl = new URL(`/services/${service.slug}/`, Astro.site ?? siteConfig.siteUrl);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.summary,
  url: serviceUrl.href,
  provider: {
    '@type': 'BeautySalon',
    name: siteConfig.brandName,
    alternateName: siteConfig.businessName,
    telephone: siteConfig.phoneDisplay,
  },
  areaServed: {
    '@type': 'City',
    name: '桃園市',
  },
};
---

<Layout
  title={`${service.title}｜桃園藝文特區｜${siteConfig.brandName}`}
  description={service.summary}
  image={service.image}
  structuredData={structuredData}
>
  <PageHero
    eyebrow={service.englishTitle}
    title={service.title}
    description={service.summary}
    image={service.image}
    imageAlt={service.imageAlt}
  />

  <section class="bg-white py-20 md:py-28">
    <div class="section-container grid grid-cols-1 gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.42fr)] lg:gap-20">
      <article>
        <p class="mb-3 text-xs uppercase text-rose tracking-ultra-wide">Service Detail</p>
        <h2 class="font-serif text-3xl font-light text-brown md:text-4xl">{service.subtitle}</h2>
        <div class="mt-7 space-y-5 text-base font-light leading-relaxed text-brown-muted">
          {service.description.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-12 grid grid-cols-1 gap-10 border-t border-cream-deeper pt-10 md:grid-cols-2">
          <div>
            <h3 class="mb-5 text-sm font-medium text-brown">服務重點</h3>
            <ul class="space-y-3">
              {
                service.highlights.map((highlight) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-brown-muted">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-rose"></span>
                    <span>{highlight}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="mb-5 text-sm font-medium text-brown">適合需求</h3>
            <ul class="space-y-3">
              {
                service.suitableFor.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-brown-muted">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-rose"></span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="mt-10 border-l-2 border-rose bg-cream px-6 py-5">
          <p class="text-xs uppercase text-rose tracking-ultra-wide">預約前提醒</p>
          <p class="mt-2 text-sm leading-relaxed text-brown-muted">{service.note}</p>
        </div>
      </article>

      <aside class="self-start rounded-lg border border-cream-deeper bg-cream p-7 lg:sticky lg:top-28">
        <p class="text-xs uppercase text-rose tracking-ultra-wide">Booking</p>
        <h2 class="mt-3 text-2xl font-light text-brown">預約這項服務</h2>
        <p class="mt-4 text-sm leading-relaxed text-brown-muted">
          請告訴我們想預約「{service.title}」、方便日期與希望了解的內容。
        </p>
        <div class="mt-7 flex flex-col gap-3">
          <a href={siteConfig.lineUrl} target="_blank" rel="noopener noreferrer" class="btn-solid text-center">LINE 預約</a>
          <a href={siteConfig.phoneUrl} class="btn-primary text-center">{siteConfig.phoneDisplay}</a>
        </div>
        <p class="mt-6 text-xs leading-relaxed text-brown-muted">
          {siteConfig.hoursLabel}<br />{siteConfig.bookingLabel}
        </p>
      </aside>
    </div>
  </section>

  <section class="bg-cream-dark py-20 md:py-24">
    <div class="section-container">
      <div class="mb-10">
        <p class="mb-3 text-xs uppercase text-rose tracking-ultra-wide">Explore More</p>
        <h2 class="font-serif text-3xl font-light text-brown">其他服務</h2>
      </div>
      <ServiceGrid limit={3} excludeSlug={service.slug} />
    </div>
  </section>
</Layout>
