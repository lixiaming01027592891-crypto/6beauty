---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { siteConfig } from '../../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
);

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout
  title={`美容知識｜${siteConfig.brandName}`}
  description="6號美學的美容知識整理，包含清粉刺、熱蠟除毛與孕婦護理等日常保養主題。"
  image="/images/blog-1.jpg"
>
  <PageHero
    eyebrow="Beauty Journal"
    title="美容知識"
    description="整理常見保養問題與服務前後需要留意的事項，幫助您在預約前先了解適合自己的方向。"
    image="/images/blog-1.jpg"
    imageAlt="美容護膚與日常保養"
  />

  <section class="bg-cream py-20 md:py-28">
    <div class="section-container">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, index) => (
            <a
              href={`/blog/${post.slug}/`}
              class="group block overflow-hidden rounded-lg border border-cream-deeper bg-white shadow-sm transition-shadow duration-300 hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-rose focus-visible:ring-offset-4"
            >
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
              </div>

              <div class="p-6">
                <div class="mb-3 flex flex-wrap gap-2">
                  {
                    post.data.tags.map((tag) => (
                      <span class="rounded-full bg-rose/5 px-3 py-1 text-[10px] uppercase text-rose/80 tracking-ultra-wide">
                        {tag}
                      </span>
                    ))
                  }
                </div>
                <h2 class="mb-3 text-xl font-light text-brown transition-colors duration-300 group-hover:text-rose">
                  {post.data.title}
                </h2>
                <p class="mb-5 line-clamp-3 text-sm font-light leading-relaxed text-brown-muted">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between border-t border-cream-deeper pt-4">
                  <time class="text-xs text-brown-muted/70" datetime={post.data.publishDate}>
                    {formatDate(post.data.publishDate)}
                  </time>
                  <span class="text-xs uppercase text-rose tracking-ultra-wide">閱讀文章 →</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream-dark py-16">
    <div class="section-container flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="mb-2 text-xs uppercase text-rose tracking-ultra-wide">Personal Advice</p>
        <h2 class="font-serif text-2xl font-light text-brown md:text-3xl">文章無法取代個人膚況溝通</h2>
        <p class="mt-3 text-sm text-brown-muted">有具體需求時，歡迎直接詢問店家再安排服務。</p>
      </div>
      <a href="/contact/" class="btn-solid">聯絡預約</a>
    </div>
  </section>
</Layout>
