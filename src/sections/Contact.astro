---
import { businessHours, siteConfig } from '../data/site';

const contactInfo = [
  {
    label: '電話',
    value: siteConfig.phoneDisplay,
    href: siteConfig.phoneUrl,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  },
  {
    label: 'LINE',
    value: siteConfig.lineId,
    href: siteConfig.lineUrl,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  },
  {
    label: '地址',
    value: siteConfig.address,
    href: siteConfig.mapUrl,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  },
];

const bookingSteps = [
  '透過 LINE 告訴我們想了解的服務與方便時段。',
  '確認需求、服務時間與預約注意事項。',
  '依約抵達，現場再次確認當日狀況後開始服務。',
];
---

<section id="contact" class="relative w-full overflow-hidden bg-cream-dark py-24 md:py-32">
  <div class="section-container relative z-10">
    <div class="mb-14 text-center md:mb-20">
      <p class="mb-4 text-xs uppercase text-rose tracking-ultra-wide">Contact</p>
      <h2 class="mb-6 font-serif text-4xl font-light text-brown md:text-5xl lg:text-6xl">
        聯絡預約
      </h2>
      <p class="mx-auto max-w-lg text-base text-brown-muted">
        全預約制，請先透過 LINE 或電話確認服務內容與可預約時段。
      </p>
    </div>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h3 class="mb-8 text-2xl font-light text-brown">商家資訊</h3>

        <div class="mb-12 space-y-6">
          {
            contactInfo.map((item) => (
              <a
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-start gap-4"
              >
                <span class="mt-0.5 text-rose"><Fragment set:html={item.icon} /></span>
                <span>
                  <span class="mb-1 block text-xs uppercase text-brown-muted tracking-ultra-wide">{item.label}</span>
                  <span class="text-brown transition-colors duration-300 group-hover:text-rose">{item.value}</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="border-t border-cream-deeper pt-8">
          <h3 class="mb-6 text-xs uppercase text-brown-muted tracking-ultra-wide">營業時間</h3>
          <div class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
            {
              businessHours.map((item) => (
                <div class="flex items-center justify-between border-b border-cream-deeper/60 py-2">
                  <span class="text-sm text-brown-muted">{item.day}</span>
                  <span class="text-sm text-brown">{item.hours}</span>
                </div>
              ))
            }
          </div>
          <p class="mt-4 text-sm text-rose">{siteConfig.bookingLabel}</p>
        </div>
      </div>

      <div class="rounded-lg border border-cream-deeper bg-white p-8 shadow-sm md:p-10">
        <p class="mb-3 text-xs uppercase text-rose tracking-ultra-wide">Booking</p>
        <h3 class="mb-3 text-2xl font-light text-brown">預約方式</h3>
        <p class="mb-8 text-sm leading-relaxed text-brown-muted">
          為確保時段與需求都能正確確認，預約會由店家透過 LINE 或電話親自回覆。
        </p>

        <ol class="mb-9 space-y-5">
          {
            bookingSteps.map((step, index) => (
              <li class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-rose text-sm text-white">
                  {index + 1}
                </span>
                <span class="pt-1 text-sm leading-relaxed text-brown-muted">{step}</span>
              </li>
            ))
          }
        </ol>

        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={siteConfig.lineUrl} target="_blank" rel="noopener noreferrer" class="btn-solid flex-1 text-center">
            LINE 預約
          </a>
          <a href={siteConfig.phoneUrl} class="btn-primary flex-1 text-center">
            電話聯繫
          </a>
        </div>

        <a
          href={siteConfig.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 block text-center text-xs text-brown-muted underline decoration-rose/40 underline-offset-4 transition-colors hover:text-rose"
        >
          在 Google 地圖查看「{siteConfig.businessName}」
        </a>
      </div>
    </div>
  </div>
</section>
