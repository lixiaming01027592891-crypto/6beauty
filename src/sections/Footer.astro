---
import { navItems, services, siteConfig } from '../data/site';
---

<footer class="relative w-full bg-rose-dark">
  <div class="section-container py-16 md:py-20">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="lg:col-span-2">
        <a href="/" class="mb-6 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full border border-white/40">
            <span class="font-serif text-lg text-white">6</span>
          </div>
          <div class="flex flex-col">
            <span class="text-sm font-medium text-white tracking-ultra-wide">{siteConfig.brandName}</span>
            <span class="text-[10px] uppercase text-white/60 tracking-ultra-wide">{siteConfig.englishName}</span>
          </div>
        </a>
        <p class="mb-7 max-w-md text-sm font-light leading-relaxed text-white/70">
          位於桃園藝文特區的美容美體工作室，提供臉部護理、身體 SPA、熱蠟除毛、敏感肌保養與孕婦護理。
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={siteConfig.lineUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/30 px-5 py-2 text-xs text-white transition-colors hover:bg-white hover:text-rose-dark">
            LINE 預約
          </a>
          <a href={siteConfig.phoneUrl} class="rounded-full border border-white/30 px-5 py-2 text-xs text-white transition-colors hover:bg-white hover:text-rose-dark">
            {siteConfig.phoneDisplay}
          </a>
        </div>
      </div>

      <div>
        <h2 class="mb-6 text-xs uppercase text-white tracking-ultra-wide">網站導覽</h2>
        <ul class="space-y-3">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-white/60 transition-colors duration-300 hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-6 text-xs uppercase text-white tracking-ultra-wide">服務與資訊</h2>
        <ul class="space-y-3">
          {
            services.slice(0, 3).map((service) => (
              <li>
                <a href={`/services/${service.slug}/`} class="text-sm text-white/60 transition-colors duration-300 hover:text-white">
                  {service.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href={siteConfig.mapUrl} target="_blank" rel="noopener noreferrer" class="text-sm leading-relaxed text-white/60 transition-colors duration-300 hover:text-white">
              {siteConfig.address}
            </a>
          </li>
          <li>
            <p class="text-sm text-white/60">{siteConfig.hoursLabel}</p>
            <p class="mt-1 text-xs text-white/45">{siteConfig.bookingLabel}</p>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="section-container flex flex-col items-center justify-between gap-3 py-6 md:flex-row">
      <p class="text-xs text-white/50">
        &copy; {new Date().getFullYear()} {siteConfig.brandName} {siteConfig.englishName}. All Rights Reserved.
      </p>
      <p class="text-xs text-white/35">桃園藝文特區・全預約制</p>
    </div>
  </div>
</footer>
