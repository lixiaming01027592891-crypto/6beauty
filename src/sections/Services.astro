---
import ServiceGrid from '../components/ServiceGrid.astro';
import { siteConfig } from '../data/site';
---

<section id="services" class="relative w-full overflow-hidden bg-white py-20 md:py-24">
  <div class="section-container mb-14 md:mb-20">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-4 text-xs uppercase text-rose tracking-ultra-wide">Services</p>
        <h2 class="font-serif text-4xl font-light text-brown md:text-5xl lg:text-6xl">
          服務項目
        </h2>
        <p class="mt-4 max-w-xl text-base text-brown-muted">
          從臉部保養到身體舒壓，先了解需求，再安排適合的預約內容。
        </p>
      </div>
      <a href="/services/" class="btn-solid self-start md:self-auto">查看全部服務</a>
    </div>
  </div>

  <div class="section-container">
    <ServiceGrid featureFirst={true} />
  </div>

  <div class="section-container mt-16 md:mt-20">
    <div class="flex flex-col overflow-hidden rounded-lg shadow-md sm:flex-row">
      <a
        href={siteConfig.lineUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 items-center justify-center gap-3 bg-rose px-6 py-6 text-sm text-white transition-colors duration-300 hover:bg-rose-dark"
      >
        LINE 詢問與預約
      </a>
      <a
        href={siteConfig.phoneUrl}
        class="flex flex-1 items-center justify-center gap-3 bg-brown-light px-6 py-6 text-sm text-white transition-colors duration-300 hover:bg-rose-dark"
      >
        電話 {siteConfig.phoneDisplay}
      </a>
    </div>
  </div>
</section>
