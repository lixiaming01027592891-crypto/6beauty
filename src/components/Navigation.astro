---
import { navItems, siteConfig } from '../data/site';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav
  id="navbar"
  data-home={isHome ? 'true' : 'false'}
  class:list={[
    'fixed left-0 top-0 z-50 w-full transition-all duration-300',
    !isHome && 'bg-white/95 shadow-sm backdrop-blur-lg',
  ]}
>
  <div class="section-container flex h-20 items-center justify-between">
    <a href="/" class="group flex items-center gap-3" aria-label={`${siteConfig.brandName}首頁`}>
      <div class="flex h-10 w-10 items-center justify-center rounded-full border border-rose/60 transition-colors duration-300 group-hover:border-rose-dark group-hover:bg-rose">
        <span class="font-serif text-lg text-rose transition-colors duration-300 group-hover:text-white">6</span>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-medium text-brown tracking-ultra-wide transition-colors duration-300 group-hover:text-rose">
          {siteConfig.brandName}
        </span>
        <span class="text-[10px] uppercase text-brown-muted tracking-ultra-wide">{siteConfig.englishName}</span>
      </div>
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-xs uppercase tracking-ultra-wide transition-colors duration-300 hover:text-rose',
              isActive(item.href) ? 'font-medium text-rose' : 'text-brown-light',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <a href={siteConfig.lineUrl} target="_blank" rel="noopener noreferrer" class="btn-solid hidden lg:inline-block">
      LINE 預約
    </a>

    <button
      id="mobile-menu-btn"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-rose text-white shadow-md transition-colors duration-300 hover:bg-rose-dark lg:hidden"
      aria-label="開啟主選單"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="absolute left-0 top-20 hidden w-full border-t border-cream-deeper bg-white/95 shadow-lg backdrop-blur-lg lg:hidden">
    <div class="section-container flex flex-col gap-5 py-7">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'mobile-nav-link text-sm uppercase tracking-ultra-wide',
              isActive(item.href) ? 'font-medium text-rose' : 'text-brown',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={siteConfig.lineUrl} target="_blank" rel="noopener noreferrer" class="btn-solid mt-2 text-center">
        LINE 預約
      </a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  const updateNavbar = () => {
    if (!navbar || navbar.dataset.home !== 'true') return;
    const scrolled = window.scrollY > 80;
    navbar.classList.toggle('bg-white/95', scrolled);
    navbar.classList.toggle('backdrop-blur-lg', scrolled);
    navbar.classList.toggle('shadow-sm', scrolled);
  };

  const closeMenu = () => {
    if (!mobileMenuButton || !mobileMenu || !menuIconOpen || !menuIconClose) return;
    mobileMenu.classList.add('hidden');
    menuIconOpen.classList.remove('hidden');
    menuIconClose.classList.add('hidden');
    mobileMenuButton.setAttribute('aria-expanded', 'false');
    mobileMenuButton.setAttribute('aria-label', '開啟主選單');
  };

  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  mobileMenuButton?.addEventListener('click', () => {
    if (!mobileMenu || !menuIconOpen || !menuIconClose) return;
    const willOpen = mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden', !willOpen);
    menuIconOpen.classList.toggle('hidden', willOpen);
    menuIconClose.classList.toggle('hidden', !willOpen);
    mobileMenuButton.setAttribute('aria-expanded', String(willOpen));
    mobileMenuButton.setAttribute('aria-label', willOpen ? '關閉主選單' : '開啟主選單');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
