---
import { siteConfig } from '../data/site';
---

<!-- Desktop Side Contact -->
<div class="fixed right-0 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col shadow-lg">
  <a 
    href={siteConfig.lineUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center justify-center bg-rose hover:bg-rose-dark transition-all duration-300 py-5 px-4"
  >
    <span class="text-white text-xs tracking-ultra-wide uppercase" style="writing-mode: vertical-rl;">
      LINE 預約
    </span>
  </a>
  <a 
    href={siteConfig.phoneUrl}
    class="group flex items-center justify-center bg-brown-light hover:bg-rose-dark transition-all duration-300 py-5 px-4 border-t border-white/10"
  >
    <span class="text-white text-xs tracking-ultra-wide uppercase transition-colors" style="writing-mode: vertical-rl;">
      電話聯繫
    </span>
  </a>
</div>

<!-- Mobile floating buttons -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-3 border-t border-cream-deeper bg-white/95 px-4 py-3 shadow-[0_-4px_20px_rgba(61,43,31,0.08)] backdrop-blur-lg lg:hidden">
  <a 
    href={siteConfig.lineUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="whitespace-nowrap rounded-full bg-rose px-5 py-3 text-center text-xs uppercase text-white shadow-md tracking-ultra-wide"
  >
    LINE 預約
  </a>
  <a 
    href={siteConfig.phoneUrl}
    class="whitespace-nowrap rounded-full bg-brown-light px-5 py-3 text-center text-xs uppercase text-white shadow-md tracking-ultra-wide"
  >
    電話聯繫
  </a>
</div>
